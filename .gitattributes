* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Preserve imported evidence/report bytes; whitespace there is data, not style.
.saipen/intake/active/*.md -whitespace
idea_continue1.md -whitespace
bench/out/*.md -whitespace

# SAIPEN byte-bound evidence (digest-verified; never convert line endings) -- T-1508.
.saipen/intake/** -text
.saipen/archive/source/** -text
.saipen/archive/retired/** -text
.saipen/recovery/log-detail/** -text
.saipen/recovery/board-compaction/** -text

# SAIPEN byte-bound evidence (digest-verified; never convert line endings) -- T-1508.
.saipen/recovery/log-normalize/** -text
.saipen/recovery/log-foreign-tail/** -text

# SAIMAIL digest-verified artifacts: evidence registrations, frozen release
# candidates with SHA256SUMS, retained experiment outputs, sanitized quarantine
# derivatives. Byte-bound; normalization would break their recorded digests.
.saipen/evidence/** -text
release/** -text
lab/out/** -text
provenance/quarantine/** -text
