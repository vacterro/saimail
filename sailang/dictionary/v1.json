{
  "version": "1",
  "note": "Three distinct things, never conflated. The ATOM is the canonical semantic identity and is what a TriageView exposes. The WIRE token is a profile-specific abbreviation and is what travels. The RENDER is a human phrase and carries no authority. The atom -> wire map must be injective: two different atoms sharing one wire token would make the wire semantically ambiguous, which the protocol forbids even where it permits disagreement about facts.",
  "supersedes": "v0, where BLOCKED and BLOCKER both mapped to BLK and were therefore indistinguishable on the wire",
  "atoms": {
    "BLOCKED": {"wire": "BLKD", "render": "work is blocked"},
    "BLOCKER": {"wire": "BLKR", "render": "the thing doing the blocking"},
    "CHECKPOINT": {"wire": "CKPT", "render": "a checkpoint"},
    "CONCURRENCY": {"wire": "CONC", "render": "concurrent execution"},
    "CONFIDENCE": {"wire": "CONF", "render": "stated confidence"},
    "CONFIGURATION": {"wire": "CFG", "render": "configuration"},
    "DATABASE": {"wire": "DB", "render": "a database"},
    "DEADLOCK": {"wire": "DLOCK", "render": "a deadlock"},
    "DEPENDENCY": {"wire": "DEP", "render": "a dependency"},
    "DUPLICATE_EXECUTION": {"wire": "DUPEX", "render": "work executed twice"},
    "ENVELOPE": {"wire": "ENVL", "render": "a message envelope"},
    "EVIDENCE": {"wire": "EVID", "render": "evidence"},
    "FILESYSTEM": {"wire": "FSYS", "render": "the filesystem"},
    "MAINTENANCE": {"wire": "MAINT", "render": "maintenance burden"},
    "METADATA": {"wire": "META", "render": "metadata"},
    "OBSERVATION": {"wire": "OBSV", "render": "an observation"},
    "OVERCLAIM": {"wire": "OCLM", "render": "a claim beyond its evidence"},
    "PARTIAL_TEST": {"wire": "PTEST", "render": "a partial test run"},
    "PERFORMANCE": {"wire": "PERF", "render": "performance"},
    "PROMOTION": {"wire": "PROMO", "render": "promotion into durable memory"},
    "QUEUE_OWNERSHIP_STALE": {"wire": "QSTALE", "render": "queue ownership left stale"},
    "RECOVERY": {"wire": "RECOV", "render": "recovery"},
    "REGRESSION": {"wire": "REGR", "render": "a regression"},
    "RETRY": {"wire": "RETRY", "render": "a retry"},
    "ROOT_CAUSE": {"wire": "RCAUS", "render": "a root cause"},
    "SESSION": {"wire": "SESS", "render": "a session"},
    "SIGNATURE": {"wire": "SIG", "render": "a signature"},
    "TEST_SUITE": {"wire": "TSUIT", "render": "the test suite"},
    "TIMESTAMP": {"wire": "TSTMP", "render": "a timestamp"},
    "VALIDATION": {"wire": "VALID", "render": "validation"}
  }
}
